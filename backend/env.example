# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Reverse proxies in front of the app: 1 on Render; 2 when the frontend's
# Vercel/Netlify /api rewrite proxies to Render (needed for correct client IPs)
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/scpms

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Required in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
# Access tokens are short-lived; sessions are kept alive by an httpOnly refresh cookie
JWT_ACCESS_EXPIRES=15m
BCRYPT_ROUNDS=12
# "lax" when the frontend reaches the API through its own /api proxy (recommended).
# "none" only if the browser calls the API on a different site directly.
COOKIE_SAMESITE=lax
# "required" (default) or "off". When required, sign-up sends a 6-digit email code.
EMAIL_VERIFICATION=required

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# Comma-separated frontend URLs allowed to call the API and open sockets
CLIENT_ORIGIN=http://localhost:5173
# Public frontend URL used in email links (defaults to the first CLIENT_ORIGIN)
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (SMTP). Without MAIL_USER/MAIL_PASS, development prints emails to the
# console; production sign-up is disabled until SMTP is configured.
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Smart Courier Management System
# Brevo HTTPS API instead of SMTP (for hosts that block SMTP ports, e.g. Render free).
# Takes precedence over SMTP; MAIL_FROM must be a sender verified in Brevo.
# BREVO_API_KEY=xkeysib-...

# ---------------------------------------------------------------------------
# Seeding (npm run seed). Required in production; dev falls back to demo values.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_AGENT_EMAIL=agent1@example.com
SEED_AGENT_PASSWORD=
